---
import Base from "../layouts/Base.astro";
import CvActions from "../components/CvActions.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { getProjects, formatDate } from "../lib/projects";
import { site } from "../data/site";
import { skills, skillGroups } from "../data/skills";
import { experience, education, languages, type CvEntry } from "../data/cv";

const projects = await getProjects();
const projectsFor = (id: string) => projects.filter((p) => (p.data.skills as string[]).includes(id));
const dev = import.meta.env.DEV;
const anyLinked = skills.some((s) => projectsFor(s.id).length > 0);
const period = (e: CvEntry) => `${e.start} – ${e.end ?? "present"}`;
---

<Base title="CV" description={`CV of ${site.name}: skills, projects, experience and education. Download as PDF.`}>
	<article class="container page cv">
		<header class="head">
			<h1>{site.name}</h1>
			<p class="lead">{site.role}</p>
			<p class="muted">{site.location} · {site.availability}</p>
			<ContactLinks />
			<CvActions />
		</header>

		<section aria-labelledby="profile">
			<h2 id="profile">Profile</h2>
			<div class="prose stack">
				<p>
					Senior data analyst with 3+ years at Better Collective, a global iGaming affiliate and performance
					marketing company. I build Python pipelines that collect large, multi-source datasets from APIs and the
					web, and turn them into dashboards and insights that drive measurable KPIs.
				</p>
				<p>
					Data-led campaigns I built have been covered by media in the US, Canada, Europe and South America,
					earning high-value backlinks for the business. I explain complex data in plain terms to non-technical
					stakeholders.
				</p>
				<p>I am looking for my first contract role, with teams of any size and industry.</p>
			</div>
		</section>

		{
			(experience.length > 0 || dev) && (
				<section aria-labelledby="experience">
					<h2 id="experience">Experience</h2>
					{experience.length > 0 ? (
						<ol class="entries">
							{experience.map((e) => (
								<li class="entry">
									<p class="mono muted when">{period(e)}</p>
									<div class="what">
										<h3>
											{e.title}, <span class="org">{e.org}</span>
										</h3>
										{e.points && (
											<ul class="points">
												{e.points.map((pt) => (
													<li>{pt}</li>
												))}
											</ul>
										)}
									</div>
								</li>
							))}
						</ol>
					) : (
						<p class="todo">TODO: add roles in src/data/cv.ts (hidden in the build while empty).</p>
					)}
				</section>
			)
		}

		<section aria-labelledby="skills">
			<h2 id="skills">Skills</h2>
			{anyLinked && <p class="muted prose">Where a skill shows a project, follow the link to see it in use.</p>}
			<div class="skill-groups">
				{
					skillGroups.map((g) => (
						<div class="skill-group">
							<h3>{g.label}</h3>
							<ul class="skill-list">
								{skills
									.filter((s) => s.group === g.id)
									.map((s) => {
										const used = projectsFor(s.id);
										return (
											<li class="skill" id={`skill-${s.id}`}>
												<span class="skill-name">{s.label}</span>
												{"note" in s && <span class="muted note">{s.note}</span>}
												{used.length > 0 && (
													<span class="used">
														Shown in{" "}
														{used.map((p, i) => (
															<>
																<a href={`/projects/${p.id}/`}>{p.data.title}</a>
																{i < used.length - 1 && ", "}
															</>
														))}
													</span>
												)}
											</li>
										);
									})}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section aria-labelledby="projects">
			<h2 id="projects">Projects</h2>
			{
				projects.length > 0 ? (
					<ol class="entries">
						{projects.map((p) => (
							<li class="entry">
								<p class="mono muted when">{formatDate(p.data.date)}</p>
								<div class="what">
									<h3>
										<a href={`/projects/${p.id}/`}>{p.data.title}</a>
									</h3>
									<p>{p.data.summary}</p>
									<p class="mono muted">{p.data.stack.join(" · ")}</p>
								</div>
							</li>
						))}
					</ol>
				) : (
					<p class="muted">The first project write-up is in progress.</p>
				)
			}
		</section>


		{
			(education.length > 0 || dev) && (
				<section aria-labelledby="education">
					<h2 id="education">Education</h2>
					{education.length > 0 ? (
						<ol class="entries">
							{education.map((e) => (
								<li class="entry">
									<p class="mono muted when">{period(e)}</p>
									<div class="what">
										<h3>
											{e.title}, <span class="org">{e.org}</span>
										</h3>
									</div>
								</li>
							))}
						</ol>
					) : (
						<p class="todo">TODO: add education in src/data/cv.ts (hidden in the build while empty).</p>
					)}
				</section>
			)
		}

		{
			(languages.length > 0 || dev) && (
				<section aria-labelledby="languages">
					<h2 id="languages">Languages</h2>
					{languages.length > 0 ? (
						<ul class="langs">
							{languages.map((l) => (
								<li>
									{l.name} <span class="muted">({l.level})</span>
								</li>
							))}
						</ul>
					) : (
						<p class="todo">TODO: add languages in src/data/cv.ts (hidden in the build while empty).</p>
					)}
				</section>
			)
		}
	</article>
</Base>

<style>
	.page {
		display: grid;
		gap: var(--space-16);
		padding-block: var(--space-12);
	}
	.head {
		display: grid;
		gap: var(--space-3);
	}
	.lead {
		font-size: var(--text-lg);
	}
	.head :global(.actions),
	.head .todo {
		margin-block-start: var(--space-3);
	}
	section {
		display: grid;
		gap: var(--space-6);
		align-content: start;
	}
	.stack {
		display: grid;
		gap: var(--space-4);
	}

	/* Skills */
	.skill-groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: var(--space-8) var(--space-12);
	}
	.skill-group {
		display: grid;
		gap: var(--space-4);
		align-content: start;
	}
	.skill-group h3 {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.skill-list {
		list-style: none;
		display: grid;
	}
	.skill {
		display: grid;
		gap: var(--space-1);
		padding-block: var(--space-3);
		border-block-start: 1px solid var(--border);
	}
	.skill:target {
		background: var(--surface);
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.skill-name {
		font-weight: 600;
	}
	.note,
	.used {
		font-size: var(--text-sm);
	}

	/* Timeline entries */
	.entries {
		list-style: none;
		display: grid;
		gap: var(--space-8);
	}
	.entry {
		display: grid;
		grid-template-columns: 10.5rem minmax(0, 1fr);
		gap: var(--space-2) var(--space-6);
	}
	.when {
		padding-block-start: 0.3em;
		font-variant-numeric: tabular-nums;
	}
	.what {
		display: grid;
		gap: var(--space-2);
		max-width: var(--measure);
	}
	.org {
		font-weight: 400;
		color: var(--muted);
	}
	.points {
		padding-inline-start: var(--space-6);
		display: grid;
		gap: var(--space-1);
	}
	.langs {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-8);
	}

	@media (max-width: 40rem) {
		.entry {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-1);
		}
	}

	/* Printing the page gives a clean one-column CV. */
	@media print {
		:global(.site-header),
		:global(.site-footer),
		:global(.skip-link),
		:global(.actions) {
			display: none;
		}
		.page {
			gap: var(--space-8);
			padding: 0;
		}
		a {
			color: inherit;
			text-decoration: none;
		}
	}
</style>
